{
  "name": "discord-panel",
  "version": "1.0.0",
  "description": "Kendi Discord sunucun için Discord benzeri web paneli (bot tabanlı)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --expose-gc --max-old-space-size=384 server.js",
    "dev": "node --env-file=.env --expose-gc server.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "express": "^5.2.1",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "socket.io": "^4.8.4"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0"
  }
}
